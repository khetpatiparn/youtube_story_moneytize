{
  "name": "youtube-story-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:renderer": "node --test apps/renderer/tests/*.test.mjs",
    "test:dashboard": "node --test apps/dashboard/tests/*.test.mjs",
